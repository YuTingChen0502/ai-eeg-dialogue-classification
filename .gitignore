# ============================================================
# Intro to AI HW3 Project
# Keep source code, notebooks, docs, and specs.
# Ignore datasets, generated outputs, model artifacts, caches,
# local environments, and editor/AI-tool states.
# ============================================================


# ============================================================
# 1. Dataset files
# ============================================================
# Dataset directories may appear under:
# - part1/task1/data/
# - part1/task2/data/
# - part2/data/
# - root data/
**/data/

# EEG dataset files
*.npz

# Dialogue dataset files and Kaggle outputs
# This intentionally ignores train.csv, test.csv, submission.csv, solution.csv, etc.
*.csv


# ============================================================
# 2. Model checkpoints / trained artifacts
# ============================================================
*.pt
*.pth
*.ckpt
*.pkl
*.pickle
*.joblib
*.model
*.bin
*.safetensors

# Common training output folders
**/outputs/
**/checkpoints/
**/runs/
**/wandb/
**/lightning_logs/
**/mlruns/
**/logs/

# Common generated prediction files
submission.*
solution.*
predictions.*
predict.*
results.*


# ============================================================
# 3. Python / Jupyter cache
# ============================================================
__pycache__/
*.py[cod]
*$py.class

.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.pyre/
.ruff_cache/
.cache/

# Coverage / test artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py.cover


# ============================================================
