# ============================================================
*.log
*.out
*.err
*.tmp
*.temp
*.bak
*.swp
*.swo


# ============================================================
# 8. Assignment packaging artifacts
# ============================================================
# Final code archive should be generated for submission, not tracked.
*.zip
*.tar
*.tar.gz
*.7z

# Usually do not track generated report PDFs.
# Keep markdown docs/specs in docs/.
*.pdf

