# ============================================================
.env
.envrc
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
__pypackages__/

# Package / build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
wheels/
site/


# ============================================================
